{
    "name": "discord-bot-template",
    "type": "module",
    "private": true,
    "workspaces": {
        "packages": [
            "apps/*",
            "packages/*"
        ],
        "catalog": {
            "@biomejs/biome": "2.4.15",
            "@types/bun": "latest",
            "lefthook": "2.1.6",
            "typescript": "6.0.3",
            "drizzle-orm": "1.0.0-rc.2",
            "drizzle-kit": "1.0.0-rc.2",
            "zod": "4.4.3",
            "hono": "4.12.23"
        }
    },
    "scripts": {
        "postinstall": "bunx lefthook install && NODE_ENV=setup bun run scripts/createEnv.ts",
        "dev": "bun --filter @repo/bot dev",
        "start": "bun --filter @repo/bot start",
        "register": "bun --filter @repo/bot register",
        "build": "turbo run build",
        "test": "turbo run test",
        "check:tsc": "turbo run check:tsc",
        "lint": "bunx @biomejs/biome lint --write",
        "lint:no-save": "bunx @biomejs/biome lint",
        "format": "bunx @biomejs/biome format --write",
        "format:no-save": "bunx @biomejs/biome format",
        "check": "bunx @biomejs/biome check --write",
        "check:no-save": "bunx @biomejs/biome check",
        "clean": "bun --filter @repo/bot clean",
        "generate": "bun --filter @repo/bot generate",
        "generate:local": "bun --filter @repo/bot generate:local",
        "migrate": "bun --filter @repo/bot migrate",
        "migrate:local": "bun --filter @repo/bot migrate:local",
        "db:seed:local": "bun --filter @repo/bot db:seed:local",
        "db:reset:local": "bun --filter @repo/bot db:reset:local",
        "studio": "bun --filter @repo/bot studio",
        "studio:local": "bun --filter @repo/bot studio:local",
        "generateERdiagram": "bun --filter @repo/bot generateERdiagram"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/bun": "catalog:",
        "lefthook": "catalog:",
        "turbo": "2.10.0",
        "typescript": "catalog:"
    },
    "trustedDependencies": [
        "@biomejs/biome",
        "esbuild"
    ],
    "packageManager": "bun@1.3.11"
}
